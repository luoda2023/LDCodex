{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LDCodex",
  "version": "88.8.6",
  "identifier": "cn.dicad.ldcodex.manager",
  "build": {
    "beforeDevCommand": "npm run workbuddy:prepare && npm run vite:dev",
    "beforeBuildCommand": "npm run launcher:stage && npm run workbuddy:prepare && npm run vite:build && npm run verify:dist",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "LDCodex 管理工具",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.ldcodex/dream-skin/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "LUODA",
    "homepage": "https://dicad.cn",
    "shortDescription": "LDCodex 管理工具",
    "longDescription": "LDCodex 管理工具：Codex++ 风格的中转与助手配置面板（作者 LUODA，官网 dicad.cn）。",
    "category": "DeveloperTool",
    "resources": [
      "workbuddy-runtime/**/*",
      "resources/**/*"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "compression": "lzma",
        "startMenuFolder": "LDCodex 管理工具"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/luoda2023/LDCodex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyREU5ODY2QjEyQ0Q5OUQKUldTZDJTeXhacGplWWpwZWlRWU9uaEk0T1RYaDBFTHBnUDNmRloxVU1LZmdXRXA5cHZ6WXlDVWkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
